{
  "manifest_version": 3,
  "name": "Preparador de Estudios - Dr. Néstor Mejía",
  "short_name": "Preparador",
  "version": "3.0.0",
  "description": "Convierte videos, JPG/PNG y DICOM en PDF grandes y legibles para Claude. Cada PDF pesa siempre menos de 40 MB.",
  "action": {
    "default_title": "Abrir Preparador de Estudios",
    "default_icon": { "16": "icons/icono16.png", "48": "icons/icono48.png", "128": "icons/icono128.png" }
  },
  "icons": { "16": "icons/icono16.png", "48": "icons/icono48.png", "128": "icons/icono128.png" },
  "background": { "service_worker": "fondo.js" },
  "permissions": ["downloads"]
}
